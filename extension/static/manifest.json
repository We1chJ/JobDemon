{
  "manifest_version": 3,
  "name": "JobDemon",
  "version": "2.0.0",
  "description": "Fills job applications from your Setup. Never submits: you check and click Submit yourself.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Show JobDemon on this page", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_page": "pages/setup.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}
